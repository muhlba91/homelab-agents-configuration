{
  "version": 3,
  "agents": {
    "defaults": {
      "workspace": "/root/.picoclaw/workspace",
      "restrict_to_workspace": true,
      "allow_read_outside_workspace": false,
      "model_name": "glm",
      "max_tokens": 32768,
      "max_tool_iterations": 35,
      "summarize_token_percent": 70,
      "summarize_message_threshold": 30,
      "temperature": 1.0,
      "subturn": {
        "max_depth": 2,
        "max_concurrent": 2,
        "default_timeout_minutes": 8,
        "default_token_budget": 32000
      }
    }
  },
  "model_list": [
    {
      "model_name": "gemini-flash-lite",
      "model": "litellm/gemini-flash-lite-latest",
      "enabled": true,
      "api_base": "http://litellm.litellm:4000/v1",
      "api_keys": [
        "${LITELLM_API_KEY}"
      ]
    },
    {
      "model_name": "glm",
      "model": "litellm/glm-flash-latest",
      "enabled": true,
      "extra_body": {
        "top_p": 0.95,
        "reasoning_effort": "high"
      },
      "api_base": "http://litellm.litellm:4000/v1",
      "api_keys": [
        "${LITELLM_API_KEY}"
      ]
    }
  ],
  "channel_list": {
    "discord": {
      "enabled": true,
      "allow_from": [
        "700068305230364768"
      ],
      "settings": {
        "mention_only": false
      }
    }
  },
  "tools": {
    "filter_sensitive_data": true,
    "filter_min_length": 8,
    "web": {
      "duckduckgo": {
        "enabled": true,
        "max_results": 3
      }
    },
    "exec": {
      "enabled": true,
      "enable_deny_patterns": true,
      "custom_allow_patterns": [
        "^picoclaw .*$"
      ]
    },
    "skills": {
      "registries": {
        "clawhub": {
          "enabled": false
        }
      }
    },
    "cron": {
      "enabled": true,
      "exec_timeout_minutes": 5
    },
    "read_file": {
      "max_read_file_size": 524288
    },
    "mcp": {
      "enabled": true,
      "discovery": {
        "enabled": true,
        "max_search_results": 5,
        "ttl": 10,
        "use_bm25": true
      },
      "servers": {
        "litellm": {
          "enabled": true,
          "type": "http",
          "url": "http://litellm.litellm:4000/mcp",
          "headers": {
            "x-litellm-api-key": "Bearer ${LITELLM_API_KEY}"
          }
        }
      }
    }
  },
  "heartbeat": {
    "enabled": true,
    "interval": 60
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "log_level": "info",
    "hot_reload": true
  }
}